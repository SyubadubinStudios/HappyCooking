<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows / Linux / macOS launcher. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HappyCooking.Desktop</RootNamespace>
    <AssemblyName>HappyCooking</AssemblyName>
    <ApplicationIcon>happycooking.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HappyCooking.App\HappyCooking.App.csproj" />
  </ItemGroup>
</Project>
