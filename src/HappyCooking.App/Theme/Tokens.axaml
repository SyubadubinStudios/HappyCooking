<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Happy Cooking design tokens.

    Palette is taken from the game's own art: the logo's tomato and butter,
    the lagoon of the world map, and a deep "blueberry" ink used for every
    outline and hard shadow. That ink is the signature: every card and button
    is a die-cut sticker with a thick outline and a solid offset shadow, so the
    whole interface feels like a pressable toy rather than a flat app.
  -->
  <Color x:Key="InkColor">#2B2A6B</Color>
  <Color x:Key="InkSoftColor">#5C5B91</Color>
  <Color x:Key="TomatoColor">#FF5A4E</Color>
  <Color x:Key="TomatoDeepColor">#E23E33</Color>
  <Color x:Key="ButterColor">#FFD45C</Color>
  <Color x:Key="MintColor">#5FD3A6</Color>
  <Color x:Key="SodaColor">#7FD1FF</Color>
  <Color x:Key="LagoonColor">#2EC4D6</Color>
  <Color x:Key="LagoonLightColor">#9BEAE6</Color>
  <Color x:Key="PaperColor">#FFFFFF</Color>
  <Color x:Key="PaperWarmColor">#FFF4D6</Color>
  <Color x:Key="GrapeColor">#B57BFF</Color>

  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
  <SolidColorBrush x:Key="TomatoBrush" Color="{StaticResource TomatoColor}" />
  <SolidColorBrush x:Key="TomatoDeepBrush" Color="{StaticResource TomatoDeepColor}" />
  <SolidColorBrush x:Key="ButterBrush" Color="{StaticResource ButterColor}" />
  <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
  <SolidColorBrush x:Key="SodaBrush" Color="{StaticResource SodaColor}" />
  <SolidColorBrush x:Key="LagoonBrush" Color="{StaticResource LagoonColor}" />
  <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="PaperWarmBrush" Color="{StaticResource PaperWarmColor}" />
  <SolidColorBrush x:Key="GrapeBrush" Color="{StaticResource GrapeColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#992B2A6B" />

  <LinearGradientBrush x:Key="LagoonGradient" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#2EC4D6" />
    <GradientStop Offset="1" Color="#A6F0E4" />
  </LinearGradientBrush>

  <!-- Type: Lilita One (chunky, like the logo) for display, Nunito (round, friendly) for reading. -->
  <FontFamily x:Key="DisplayFont">avares://HappyCooking.App/Assets/Fonts#Lilita One</FontFamily>
  <FontFamily x:Key="BodyFont">avares://HappyCooking.App/Assets/Fonts#Nunito</FontFamily>

  <x:Double x:Key="TextDisplay">44</x:Double>
  <x:Double x:Key="TextTitle">30</x:Double>
  <x:Double x:Key="TextHeading">22</x:Double>
  <x:Double x:Key="TextBody">16</x:Double>
  <x:Double x:Key="TextSmall">13</x:Double>

  <!-- Space a page leaves for the HUD (top) and the dock (bottom). -->
  <Thickness x:Key="PageMargin">20,92,20,128</Thickness>

  <CornerRadius x:Key="StickerRadius">22</CornerRadius>
  <CornerRadius x:Key="PillRadius">999</CornerRadius>
  <Thickness x:Key="StickerOutline">3</Thickness>
  <BoxShadows x:Key="StickerShadow">0 6 0 0 #2B2A6B</BoxShadows>
  <BoxShadows x:Key="StickerShadowPressed">0 2 0 0 #2B2A6B</BoxShadows>
</ResourceDictionary>
