<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HappyCooking.App.ViewModels"
             xmlns:c="using:HappyCooking.App.Controls"
             xmlns:svc="using:HappyCooking.App.Services"
             x:Class="HappyCooking.App.Views.RestaurantView"
             x:DataType="vm:RestaurantViewModel">
  <Grid>
    <c:StageHost Stage="{Binding Stage}" />

    <Grid Margin="{StaticResource PageMargin}" ColumnDefinitions="340,*,320">

      <!-- Guests and their orders -->
      <Border Classes="sticker" VerticalAlignment="Top" Padding="12">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{svc:Tr restaurant.guests}" Classes="heading" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Image Source="{Binding StarIcon}" Width="20" />
              <TextBlock Text="{Binding Rating}" Classes="heading" FontSize="18" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{svc:Tr restaurant.noMenu}" IsVisible="{Binding MenuEmpty}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Guests}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GuestCard">
                <Border CornerRadius="16" BorderThickness="2" BorderBrush="{StaticResource InkBrush}" Background="{StaticResource PaperWarmBrush}" Padding="8">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <Border Grid.RowSpan="2" Width="46" Height="46" CornerRadius="23" ClipToBounds="True" BorderBrush="{StaticResource InkBrush}" BorderThickness="2">
                      <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0">
                      <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" />
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="12" Height="12" Fill="{Binding Swatch}" Stroke="{StaticResource InkBrush}" StrokeThickness="1" />
                        <TextBlock Text="{Binding Order}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Grid.RowSpan="2" Classes="small go" Content="{svc:Tr restaurant.serve}" IsEnabled="{Binding CanServe}"
                            Command="{Binding $parent[UserControl].((vm:RestaurantViewModel)DataContext).ServeCommand}" CommandParameter="{Binding}" />
                    <ProgressBar Grid.Row="1" Grid.Column="1" Margin="8,4,8,0" Value="{Binding Patience}" Maximum="100" Height="8" MinHeight="8"
                                 Classes.tomato="{Binding IsHurrying}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding LastServe}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{StaticResource InkSoftBrush}" />
        </StackPanel>
      </Border>

      <!-- Counter + decorations -->
      <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Top">
        <Border Classes="sticker warm" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="{svc:Tr restaurant.counter}" Classes="heading" />
            <TextBlock Text="{svc:Tr restaurant.counterEmpty}" IsVisible="{Binding CounterEmpty}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Counter}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CounterItem">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Width="16" Height="16" Fill="{Binding Swatch}" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="ExtraBold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="small primary" FontSize="16" Padding="14,4" Content="{svc:Tr restaurant.cookMore}" Command="{Binding GoCookCommand}" />
              <Button Classes="small butter" Content="{svc:Tr restaurant.decorate}" Command="{Binding ToggleShopCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="sticker" Padding="12" IsVisible="{Binding ShowShop}">
          <StackPanel Spacing="8">
            <TextBlock Text="{svc:Tr restaurant.shop}" Classes="heading" />
            <ScrollViewer MaxHeight="330">
              <ItemsControl ItemsSource="{Binding Shop}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DecorationCard">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="30" Height="30" CornerRadius="8" Background="{Binding Swatch}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" />
                      <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" />
                        <TextBlock Classes="small" Text="{Binding Rating}" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="small" IsVisible="{Binding !Owned}"
                              Command="{Binding $parent[UserControl].((vm:RestaurantViewModel)DataContext).BuyCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Image Source="{Binding $parent[UserControl].((vm:RestaurantViewModel)DataContext).CoinIcon}" Width="18" />
                          <TextBlock Text="{Binding Price}" FontFamily="{StaticResource DisplayFont}" FontSize="15" />
                        </StackPanel>
                      </Button>
                      <TextBlock Grid.Column="2" Text="{svc:Tr restaurant.placed}" IsVisible="{Binding Owned}" FontWeight="ExtraBold"
                                 Foreground="{StaticResource MintBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
